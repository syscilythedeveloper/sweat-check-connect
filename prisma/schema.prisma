datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

generator client {
  provider = "prisma-client-js"
}

model User {
  id             String   @id @default(cuid())                              
  username       String   @unique                      
  email          String   @unique
  avatar      String?
  bio            String?
  name            String?

  isPrivate      Boolean  @default(false)
  membershipType MembershipType @default(STANDARD) 

  followers      UserFollow[] @relation("followers")
  following      UserFollow[] @relation("following") 
  daysActive     Int      @default(0) 
  currentActiveStreak  Int      @default(0)
  longestActiveStreak  Int      @default(0)


  checkIns       CheckIn[]
  challenges     UserChallenge[]   // Participating challenges (via join table)
  sentMessages   DirectMessage[] @relation("sentMessages")
  receivedMessages DirectMessage[] @relation("receivedMessages")
  sentChallengeMessages ChallengeMessage[] @relation("SentChallengeMessages")
  challengeMessageReactions ChallengeMessageReaction[]

  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  notifications  Notification[] @relation("UserNotifications")
  sentNotifications Notification[] @relation("SentNotifications")
  

  createdChallenges Challenge[] @relation("CreatedChallenges") 
 
  checkInComments CheckInComment[]
  checkInCommentReactions CheckInCommentReaction[]
  checkInReactions CheckInReaction[]

  @@index([daysActive])
  @@index([username])
}

enum MembershipType {
  STANDARD
  PRO
  PREMIUM
}

model UserChallenge {
  id                String   @id @default(cuid())
  userId            String
  challengeId       String
  checkInsCompleted Int      @default(0)
  isCompleted       Boolean  @default(false)
  joinedAt          DateTime @default(now())
  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
  challenge Challenge @relation(fields: [challengeId], references: [id])
  @@unique([userId, challengeId])
  @@index([challengeId])
}

model Notification {
  id        String   @id @default(cuid())
  userId    String
  senderId  String?                      
  type      NotificationType
  targetType  String?    
  targetId    String?    
  isRead    Boolean  @default(false)
  createdAt DateTime @default(now())
  user User @relation("UserNotifications", fields: [userId], references: [id], onDelete: Cascade)
  sender    User?    @relation("SentNotifications", fields: [senderId], references: [id], onDelete: SetNull)
  expiresAt DateTime?
  
 
}

enum NotificationType {
  REACTION         
  COMMENT             
  MESSAGE
  FOLLOW_REQUEST           
  CHALLENGE_JOINED        
  CHALLENGE_COMPLETED      
  INVITE                   
  CHALLENGE_UPDATED  
}


model CheckIn {
  id            String   @id @default(cuid())
  userId        String
  challengeId   String?                          

  caption       String?
  videoUrl      String
  thumbnailUrl  String?
  fileSize      Int                              
  mimeType      String
  duration      Float?                           

  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt

  // Relations
  user          User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  challenge     Challenge? @relation(fields: [challengeId], references: [id])
  reactions     CheckInReaction[]
  comments      CheckInComment[]


  @@index([userId])
  @@index([createdAt])
 
}

model Challenge {
  id              String    @id @default(cuid())
  title           String
  description     String
  startDate       DateTime
  duration        Int       
  frequencyType   FrequencyType @default(DAILY) // enum: DAILY or WEEKLY
  checkInsPerWeek Int? // only relevant if frequencyType = WEEKLY
  requiredCheckIns  Int
  maxParticipants Int?      
  isPrivate       Boolean   @default(false)
  tags            String[] // PostgreSQL supports string arrays
  createdById     String?
  createdBy       User? @relation("CreatedChallenges", fields: [createdById], references: [id], onDelete: SetNull)
  participants    UserChallenge[]  
  checkIns        CheckIn[]        
  chatMessages    ChallengeMessage[]        
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt
  totalCheckIns   Int
  status           ChallengeStatus @default(UPCOMING)

  @@index([createdById])
  @@index([status])
  @@index([startDate])

}

enum FrequencyType {
  DAILY
  WEEKLY
}

model ChallengeMessage {
  id          String   @id @default(cuid())
  challengeId String
  userId      String
  content     String
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  challenge   Challenge @relation(fields: [challengeId], references: [id], onDelete: Cascade)
  sender      User      @relation("SentChallengeMessages",fields: [userId], references: [id], onDelete: Cascade)
  reactions   ChallengeMessageReaction[]

    @@index([challengeId])


}

model DirectMessage {
  id           String   @id @default(cuid())
  senderId     String
  recipientId  String
  content      String
  messageRead   Boolean @default(false)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  sender       User @relation("sentMessages", fields: [senderId], references: [id], onDelete: Cascade)
  recipient    User @relation("receivedMessages", fields: [recipientId], references: [id], onDelete: Cascade)
  reactions    DirectMessageReaction[]
  @@index([senderId, recipientId])

  
}



model ChallengeMessageReaction {
  id            String   @id @default(cuid())
  userId        String
  challengeMessageId String
  type          ReactionType
  createdAt     DateTime @default(now())

  challengeMessage ChallengeMessage @relation(fields: [challengeMessageId], references: [id], onDelete: Cascade)
  user User @relation(fields: [userId], references: [id], onDelete: Cascade)


  @@unique([userId, challengeMessageId, type])
}
model DirectMessageReaction {
  id            String   @id @default(cuid())
  userId        String
  directMessageId String
  type          ReactionType
  createdAt     DateTime @default(now())

  directMessage  DirectMessage     @relation(fields: [directMessageId], references: [id], onDelete: Cascade)

  @@unique([userId, directMessageId, type])
}

enum ReactionType {
  CLAP
  FIRE
  STRONG
  LOVE
}
model CheckInReaction {
  id         String   @id @default(cuid())
  userId     String
  checkInId  String
  type       ReactionType
  createdAt  DateTime @default(now())
  checkIn    CheckIn  @relation(fields: [checkInId], references: [id], onDelete: Cascade)
  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, checkInId, type]) 
}



model CheckInComment {
  id         String   @id @default(cuid())
  userId     String
  checkInId  String
  content    String
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt
  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
  checkIn    CheckIn  @relation(fields: [checkInId], references: [id], onDelete: Cascade)
  reactions  CheckInCommentReaction[]
}

model CheckInCommentReaction {
  id         String   @id @default(cuid())
  userId     String
  commentId  String
  type       ReactionType
  createdAt  DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
  comment    CheckInComment    @relation(fields: [commentId], references: [id] , onDelete: Cascade)

  @@unique([userId, commentId, type])
}

model UserFollow {
  id           String   @id @default(cuid())
  followerId   String
  followingId  String
  status       FollowStatus @default(PENDING)
  createdAt    DateTime @default(now())

  follower     User @relation("following", fields: [followerId], references: [id], onDelete: Cascade)
  following    User @relation("followers", fields: [followingId], references: [id], onDelete: Cascade)

  @@unique([followerId, followingId])
}

enum FollowStatus {
    PENDING
    ACCEPTED
    BLOCKED

}

enum ChallengeStatus {
  UPCOMING
  ACTIVE
  COMPLETED
}